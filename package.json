{
  "name": "stackmint",
  "version": "0.1.0",
  "description": "Scaffold any TypeScript full-stack project in seconds",
  "type": "module",
  "bin": {
    "stackmint": "./dist/bin/stackmint.js"
  },
  "scripts": {
    "dev": "tsx bin/stackmint.ts",
    "build": "tsup bin/stackmint.ts --format cjs,esm --dts",
    "test": "vitest run",
    "test:smoke": "vitest run tests/smoke"
  },
  "keywords": [
    "scaffold",
    "cli",
    "typescript",
    "nextjs",
    "full-stack",
    "create",
    "template",
    "drizzle",
    "trpc",
    "hono"
  ],
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^1.3.0",
    "chalk": "^5.6.2",
    "execa": "^9.6.1",
    "fs-extra": "^11.3.5",
    "ora": "^9.4.0",
    "semver": "^7.8.0",
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/node": "^25.6.2",
    "@types/fs-extra": "^11.0.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}